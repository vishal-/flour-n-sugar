datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum PlatformRole {
  USER
  MODERATOR
  SUPPORT
  ADMIN
}

enum StoreRole {
  OWNER
  MANAGER
  BAKER
  STAFF
  DELIVERY
  ACCOUNTANT
}

enum StoreStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum StoreType {
  HOME_BAKER
  BAKERY
  CAKE_SHOP
  CAFE
  OTHER
}

enum ImageType {
  PRODUCT
  STORE_LOGO
  STORE_COVER
  STORE_GALLERY
  USER_AVATAR
  REVIEW
}

enum ProductCategory {
  CAKES
  COOKIES_AND_BISCUITS
  BREADS
  PASTRIES
  PIES_TARTS_AND_QUICHES
  BROWNIES_AND_BARS
  DONUTS_AND_FRITTERS
  DESSERTS
  SAVORY_BAKES
  CONFECTIONERY
}


// ─────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Platform-level role
  platformRole PlatformRole @default(USER)

  // Stores this user belongs to
  storeMemberships StoreMember[]

  // Customer profile
  customerProfile CustomerProfile?

  // Uploaded media assets
  images Image[]

  // Better Auth
  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}


// ─────────────────────────────────────────────────────────────
// STORE / TENANT
// ─────────────────────────────────────────────────────────────

model Store {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status    StoreStatus @default(DRAFT)
  storeType StoreType   @default(HOME_BAKER)

  // Public store information
  description  String?
  logo         String?
  coverImage   String?
  phone        String?
  contactEmail String?

  // Location & Operations
  address          String?
  city             String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  deliveryRadiusKm Int?     @default(10)
  isHomeBaker      Boolean  @default(true)

  // Profile & Story
  about         String?
  specialties   String[] @default([])
  workingDays   String[] @default([])
  leadTimeHours Int?     @default(24)
  instagram     String?
  facebook      String?
  whatsapp      String?
  website       String?

  // Relations
  members  StoreMember[]
  products Product[]
  images   Image[]

  @@map("store")
}


// ─────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     String   @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal         @db.Decimal(10, 2)
  images      String[]        @default([])
  category    ProductCategory @default(CAKES)

  // Dietary tags
  isEggless    Boolean  @default(false)
  isVegan      Boolean  @default(false)
  isGlutenFree Boolean  @default(false)
  isAvailable  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Media relation
  media Image[]

  @@index([storeId])
  @@map("product")
}


// ─────────────────────────────────────────────────────────────
// UNIFIED MEDIA / IMAGE ASSET
// ─────────────────────────────────────────────────────────────

model Image {
  id           String    @id @default(uuid(7)) @db.Uuid

  // Entity associations
  storeId      String?   @db.Uuid
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId    String?   @db.Uuid
  product      Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         ImageType @default(PRODUCT)

  // Multi-resolution asset URLs
  originalUrl  String
  mediumUrl    String?   // ~800px width for catalog / modal views
  thumbnailUrl String?   // ~200px width for thumbnails / list views
  blurHash     String?   // progressive loading placeholder string

  // Metadata & display ordering
  altText      String?
  caption      String?
  sortOrder    Int       @default(0)
  mimeType     String?   // e.g. "image/webp", "image/jpeg"
  sizeBytes    Int?      // storage size tracking

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, type])
  @@index([productId, sortOrder])
  @@index([userId])
  @@map("image")
}


// ─────────────────────────────────────────────────────────────
// USER ↔ STORE
// ─────────────────────────────────────────────────────────────

model StoreMember {
  id String @id @default(uuid(7)) @db.Uuid

  userId  String @db.Uuid
  storeId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  role StoreRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@map("store_member")
}


// ─────────────────────────────────────────────────────────────
// CUSTOMER PROFILE
// ─────────────────────────────────────────────────────────────

model CustomerProfile {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profile")
}


// ─────────────────────────────────────────────────────────────
// BETTER AUTH - SESSION
// ─────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}


// ─────────────────────────────────────────────────────────────
// BETTER AUTH - ACCOUNT
// ─────────────────────────────────────────────────────────────

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?

  scope    String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}


// ─────────────────────────────────────────────────────────────
// BETTER AUTH - VERIFICATION
// ─────────────────────────────────────────────────────────────

model Verification {
  id         String    @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}